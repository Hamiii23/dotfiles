* {
    bg:          rgba(16,  16,  22,  97%);
    bg-alt:      rgba(22,  22,  32,  97%);
    bg-selected: rgba(18,  20,  30,  99%);
    border-col:  rgba(99,  160, 255, 22%);
    border-sub:  rgba(255, 255, 255, 8%);
    fg:          rgba(242, 242, 250, 96%);
    fg-dim:      rgba(165, 165, 190, 78%);
    accent:      rgba(99,  160, 255, 100%);
    accent-dim:  rgba(99,  160, 255, 75%);
    none:        rgba(0,   0,   0,   0%);

    background-color: @none;
    text-color:       @fg;
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    width:            640px;
    background-color: @bg;
    border:           1px;
    border-color:     @border-sub;
    border-radius:    20px;
    padding:          12px;
}

mainbox {
    background-color: @none;
    children:         [ inputbar, message, listview ];
    spacing:          10px;
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-sub;
    border-radius:    14px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: @none;
    text-color:       @accent-dim;
    font:             "Cantarell Bold 13";
}

entry {
    background-color:  @none;
    text-color:        @fg;
    placeholder:        "Filter clipboard...";
    placeholder-color:  @fg-dim;
    cursor:             text;
}

message {
    background-color: @none;
    padding:           2px 4px 0px 4px;
}

textbox {
    background-color: @none;
    text-color:       @fg-dim;
    font:             "Cantarell 10";
}

listview {
    background-color: @none;
    lines:            9;
    columns:          1;
    fixed-height:     true;
    spacing:          3px;
    scrollbar:        false;
}

element {
    background-color: @none;
    border-radius:    12px;
    padding:          7px 12px;
    children:         [ element-text ];
}

element normal.normal {
    background-color: @none;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-selected;
    border:           1px;
    border-color:     @border-col;
    text-color:       @accent;
}

element-text {
    background-color: @none;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font 11";
    vertical-align:   0.5;
    highlight:        bold;
}

error-message {
    background-color: @bg;
    border-radius:    14px;
    padding:          20px;
    text-color:       @fg-dim;
}
